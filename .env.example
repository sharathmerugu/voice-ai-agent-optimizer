# --- Marketplace app credentials (required) ---------------------------------
# Developer Portal > your app > Advanced Settings > Auth.
# These let the app exchange an install code for a token scoped to whichever
# sub-account installed it, so one deployment serves every installing account.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# Anthropic API key for the analysis / evaluation calls
ANTHROPIC_API_KEY=

# --- Local development shortcut (optional) ----------------------------------
# A Private Integration Token lets you run the pipeline from the CLI without
# installing the app. It is only ever used for the single location named below,
# so a deployed instance cannot serve one tenant's data to another.
# Sub-account > Settings > Private Integrations. Scopes are fixed at creation
# and must include the Voice AI read scopes.
GHL_LOCATION_ID=
GHL_PIT=

# Set in production so installs, labels and cached analyses survive a restart.
# Unset locally: the store falls back to per-key files under data/kv/.
REDIS_URL=

# --- Tuning (all optional; the defaults are the intended configuration) ------
# Synthesis: which model writes the issues, tests and recommendations, and how
# hard it thinks. Effort is the main latency lever — Sonnet 5 thinks adaptively
# at `high` by default, which on three sequential calls is most of the wall
# clock. Values: low | medium | high | xhigh | max.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# Labelling: the cheap model that reads each transcript once, and how many it
# reads at a time. Raise the concurrency to speed up a large first run, within
# whatever rate limit the key has.
LABEL_MODEL=
LABEL_CONCURRENCY=

# How many calls a single run will label, newest first. Below this, every call
# the agent has taken is read and counted. Above it, the run covers the most
# recent N and the UI says which — a true census of a window, not an estimate
# over everything.
#
# Note the window does not crawl backwards: each run fetches the newest N, so
# new calls enter it and old ones fall out. Raising this is currently the only
# way to reach further back. Labels never expire, so raising it only pays for
# the calls it newly reaches.
ANALYSIS_MAX_CALLS=

PORT=3000
