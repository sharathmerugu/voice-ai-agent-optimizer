# --- Marketplace app credentials (required) ---------------------------------
# Developer Portal > your app > Advanced Settings > Auth.
# These let the app exchange an install code for a token scoped to whichever
# sub-account installed it, so one deployment serves every installing account.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# Anthropic API key for the analysis / evaluation calls
ANTHROPIC_API_KEY=

# --- Local development shortcut (optional) ----------------------------------
# A Private Integration Token lets you run the pipeline from the CLI without
# installing the app. It is only ever used for the single location named below,
# so a deployed instance cannot serve one tenant's data to another.
# Sub-account > Settings > Private Integrations. Scopes are fixed at creation
# and must include the Voice AI read scopes.
GHL_LOCATION_ID=
GHL_PIT=

PORT=3000
