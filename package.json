{
  "name": "voice-ai-agent-optimizer",
  "version": "1.0.0",
  "description": "Analyzes HighLevel Voice AI call transcripts, generates test cases, and recommends agent configuration changes.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "vite build",
    "probe": "node --env-file=.env src/probe.js",
    "verify": "node src/verify.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "express": "^5.1.0",
    "redis": "^6.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.1.0",
    "vue": "^3.5.0"
  }
}
